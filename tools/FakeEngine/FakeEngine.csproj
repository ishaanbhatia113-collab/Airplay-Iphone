<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the real AirPlay engine, for working on the app without an Apple device at hand.
    It is called uxplay.exe on purpose: point "Advanced > Engine location" in MirrorDeck at it.
    It is never part of a release build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>uxplay</AssemblyName>
    <RootNamespace>MirrorDeck.FakeEngine</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
